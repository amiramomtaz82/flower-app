default_platform(:android)

platform :android do
  desc "Upload Release APK to Firebase App Distribution"
  lane :distribute_firebase do
    apk_path = ENV["APK_PATH"] || "../build/app/outputs/flutter-apk/app-release.apk"

    UI.user_error!("Could not find APK at #{apk_path}") unless File.exist?(apk_path)

    firebase_app_distribution(
      app: ENV["FIREBASE_ANDROID_APP_ID"],
      service_credentials_file: ENV["FIREBASE_CREDENTIALS_PATH"] || "firebase_credentials.json",
      groups: ENV["FIREBASE_TESTER_GROUPS"] || "testers",
      release_notes: ENV["RELEASE_NOTES"] || "Automated deployment from GitHub Actions",
      apk_path: apk_path
    )
  end
end
